{
  "routes": [
    {
      "route": "/",
      "rewrite": "/home/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*.{png,jpg,gif,svg}",
      "/css/*",
      "/js/*",
      "/*.{css,scss,js,json,ico,woff,woff2,ttf,txt,xml}",
      "/robots.txt",
      "/sitemap.xml",
      "/sitemap-*.xml"
    ]
  },
  "mimeTypes": {
    ".xml": "application/xml"
  }
}
